# macOS
.DS_Store

# Xcode: per-user state, never shared
xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout
DerivedData/
build/
*.xcresult
*.ipa
*.dSYM.zip
*.dSYM

# Swift Package Manager
.swiftpm/
.build/

# Proxy (Node). Secrets live only on the server.
proxy/node_modules/
proxy/config.json
proxy/*.p8
proxy/*.log
node_modules/

# Android (android/). Secrets and account-specific files never go in this public repo.
android/.gradle/
android/.kotlin/
android/.idea/
android/local.properties
android/keystore.properties
android/**/build/
android/**/google-services.json
android/captures/
*.jks
*.keystore
*.apk
*.aab
*.iml

# Firebase service account for the proxy (FCM). Server only.
proxy/*service-account*.json
proxy/firebase*.json
